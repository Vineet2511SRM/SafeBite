# ================================================================
# SafeBite — Git Ignore
# ================================================================

# ---------- Dependencies ----------
node_modules/
*/node_modules/

# ---------- Environment ----------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- Build Outputs ----------
build/
dist/
out/

# ---------- Logs ----------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- OS Files ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- IDE / Editor ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Testing ----------
coverage/
.nyc_output/

# ---------- Misc ----------
*.tgz
.cache/
.temp/
