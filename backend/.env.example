# ================================================================
# SafeBite — Environment Variables Template
# ================================================================
# Copy this file to .env and fill in your values.
# ================================================================

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=SafeBite

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
